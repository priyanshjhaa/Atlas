NODE_ENV=development
HOST=0.0.0.0
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=2000
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_BLOCK_MS=60000
API_MAX_BODY_BYTES=1048576
# Set to the exact number of trusted reverse proxies in front of the API
TRUST_PROXY_HOPS=0
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:4000
GITHUB_APP_ID=
# Base64-encoded GitHub App PEM private key
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback
# Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=
SYNC_WORKER_CONCURRENCY=2
REPOSITORY_STORAGE_PATH=/tmp/atlas-repositories
PILOT_FEEDBACK_RETENTION_DAYS=180
EMBEDDINGS_PROVIDER=local
OPENAI_API_KEY=
LLM_EXPLANATIONS_ENABLED=false
LLM_PROVIDER=openai
LLM_EXPLANATION_MODEL=
# Optional Groq-only fallback for transient provider failures
LLM_FALLBACK_MODEL=
LLM_EXPLANATION_TIMEOUT_MS=15000
LLM_MAX_EVIDENCE_ITEMS=12
LLM_MAX_EVIDENCE_CHARACTERS=10000
LLM_MAX_PACKET_CHARACTERS=14000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_REASONING_EFFORT=low
LLM_MAX_EXPLANATION_CHARACTERS=20000
LOG_LEVEL=info
